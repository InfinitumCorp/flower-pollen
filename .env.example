# Copy to .env (never commit .env). All values are optional.
HOST=127.0.0.1
PORT=8080
FP_DB_PATH=./data/flower-pollen.db
FP_SWEEP_MS=5000
FP_TELEMETRY_RETENTION_DAYS=30

# Ed25519 key that signs station commands. Created on first run if missing. Back it up;
# stations pin its public key (GET /v1/signing-key), so replacing it means re-provisioning them.
FP_SIGNING_KEY_PATH=./data/command-signing-key.pem

# HTTPS, and mTLS for station client certificates (see deploy/pki/README.md).
# FP_TLS_CERT=./pki/server.pem
# FP_TLS_KEY=./pki/server-key.pem
# FP_CA_CERT=./pki/ca.pem
